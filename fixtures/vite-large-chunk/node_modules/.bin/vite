#!/usr/bin/env sh
out=""
while [ "$#" -gt 0 ]; do
  if [ "$1" = "--outDir" ]; then
    shift
    out="$1"
  fi
  shift
done
if [ -n "$out" ]; then
  mkdir -p "$out/assets"
  printf 'large chunk placeholder' > "$out/assets/app.js"
fi
echo "(!) Some chunks are larger than 500 kB after minification. Consider:"
echo "- Using dynamic import() to code-split the application"
exit 0
