#!/usr/bin/env sh
out=""
while [ "$#" -gt 0 ]; do
  if [ "$1" = "--outDir" ]; then
    shift
    out="$1"
  fi
  shift
done
if [ -n "$out" ]; then
  mkdir -p "$out/assets"
  printf '<div id="app"></div>' > "$out/index.html"
  printf 'current build asset' > "$out/assets/current.js"
fi
echo "fixture current build passed"
exit 0
